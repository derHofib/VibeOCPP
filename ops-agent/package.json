{
  "name": "ops-agent",
  "version": "0.0.1",
  "private": true,
  "description": "Whitelisted container-ops microservice — restart/status/logs for a fixed set of known services, nothing else. See README.md.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dockerode": "^4.0.7"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.44",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
