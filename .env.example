# Bootstrap values for docker-compose.yml. Copy to .env and fill in real
# values before running `docker compose up`. Everything else is product
# configuration and lives in the `settings` table — see
# docs/architecture-proposal.md §5.

# Activates the bundled CitrineOS-core stack (citrine/ocpp-db/amqp-broker/
# minio/graphql-engine) with no --profile flag needed — Compose reads this
# from .env automatically. Remove this line (or set it empty) to run
# VibeOCPP against an external CitrineOS instead; you'll then need to
# configure settings/citrineos/dataApiUrl+messageApiUrl yourself (see
# README.md) instead of relying on citrineos-config-init.
COMPOSE_PROFILES=citrineos-core

PRODUCT_DB_USER=csms
PRODUCT_DB_PASSWORD=change-me
PRODUCT_DB_NAME=csms_product
PRODUCT_DB_PORT=55432

BACKEND_PORT=3000

# openssl rand -base64 48
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# openssl rand -base64 32 — must decode to exactly 32 bytes (AES-256)
SETTINGS_MASTER_KEY=change-me

# openssl rand -hex 32 — shared between `backend` and `ops-agent` only, never
# exposed on a public port. See ops-agent/README.md.
OPS_AGENT_SHARED_SECRET=change-me

# The first login — backend/docker-entrypoint.sh seeds this SuperAdmin on
# every start (a no-op once it already exists), and citrineos-config-init
# below authenticates as it. openssl rand -base64 24 for the password.
SEED_SUPERADMIN_EMAIL=superadmin@example.com
SEED_SUPERADMIN_PASSWORD=change-me

# --- Bundled CitrineOS-core stack (profile "citrineos-core", on by default
# via COMPOSE_PROFILES above) — see citrineos-vendor/README.md. Host ports
# only; every value below already has a working default, so none of these
# need to be set unless a port collides with something else on your host.
CITRINEOS_CORE_HTTP_PORT=8080
CITRINEOS_CORE_WS_PORT=8081
CITRINEOS_CORE_WS_BASIC_AUTH_PORT=8082
CITRINEOS_CORE_WSS_PORT=8443
CITRINEOS_CORE_WSS_MTLS_PORT=8444
CITRINEOS_CORE_HASURA_PORT=8090
CITRINEOS_CORE_AMQP_PORT=5672
CITRINEOS_CORE_AMQP_MANAGEMENT_PORT=15672
CITRINEOS_CORE_MINIO_PORT=9000
CITRINEOS_CORE_MINIO_CONSOLE_PORT=9001
# citrine (the OCPP server) and MinIO both read this pair — MinIO is where
# CitrineOS stores firmware/diagnostics files, accessed via the S3 API.
CITRINEOS_CORE_MINIO_ROOT_USER=minioadmin
CITRINEOS_CORE_MINIO_ROOT_PASSWORD=minioadmin
# Internal-only (no host port) — change from CitrineOS-core's own upstream
# default if that matters for your environment.
CITRINEOS_CORE_DB_PASSWORD=citrine

# --- Optional: only needed for `docker compose --profile payment up` ---
# See the comments in docker-compose.yml for what each of these is for.
CITRINEOS_PAYMENT_PATH=../citrineos-payment
CITRINEOS_PAYMENT_PORT=9010
DIRECTUS_KEY=change-me
DIRECTUS_SECRET=change-me
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=change-me
DIRECTUS_PORT=8055

# --- Optional: only needed for `docker compose --profile hasura up` ---
# See hasura/README.md for what this instance is and how it's secured.
# Defaults to the bundled ocpp-db above — only set this if pointing at an
# external CitrineOS instead (e.g. postgres://citrine:citrine@your-host:5432/citrine).
CITRINEOS_DATABASE_URL=
HASURA_GRAPHQL_ADMIN_SECRET=change-me
HASURA_PORT=8091
