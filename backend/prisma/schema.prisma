// Product database schema for the CSMS BFF. CitrineOS domain data (stations,
// transactions, meter values) is NOT modeled here — it stays in CitrineOS's
// own database and is reached only through its REST APIs / our read-only
// Hasura mirror. This schema holds only product-owned data.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Multi-tenancy is prepared but not shipped: exactly one row exists in
// Phase 1, and every tenant-scoped table below carries tenantId from day
// one so a later rollout needs no schema migration, only new tenant rows
// and removing the single-tenant assumption in application code.
model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  settings          Setting[]
  auditLogs         AuditLog[]
  citrineOsMessages CitrineOsMessageLog[]
  testSuiteRuns     TestSuiteRun[]

  @@map("tenants")
}

// Driver is modeled but intentionally unused in Phase 1: no auth flow, no
// endpoints, no UI issue it. It exists so a future driver portal needs no
// role migration, only new code paths gated on it.
enum Role {
  SuperAdmin
  Admin
  Mitarbeiter
  Driver

  @@map("role")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
  testSuiteRuns  TestSuiteRun[]

  @@unique([tenantId, email])
  @@map("users")
}

// Refresh tokens are stored hashed and rotated on use (single-use), so a
// stolen token file/log entry cannot be replayed even if the DB leaks.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@map("refresh_tokens")
}

enum SettingType {
  string
  number
  boolean
  json
  secret

  @@map("setting_type")
}

// The versioned settings store described in the architecture proposal:
// non-secret values are readable as-is, secret values are stored encrypted
// (see SettingsService) and only ever returned masked over the API.
model Setting {
  id        String      @id @default(uuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  category  String
  key       String
  type      SettingType
  value     String? // plaintext JSON-encoded value; null when encrypted
  encryptedValue Bytes? // AES-256-GCM ciphertext; null when not a secret
  encryptionIv   Bytes? // null when not a secret
  encryptionTag  Bytes? // null when not a secret
  version   Int         @default(1)
  updatedBy String?
  updatedAt DateTime    @updatedAt
  createdAt DateTime    @default(now())

  history SettingHistory[]

  @@unique([tenantId, category, key])
  @@map("settings")
}

// One row per change, so any setting can be rolled back to a prior version
// from the SuperAdmin UI, per the architecture proposal's audit/rollback
// requirement.
model SettingHistory {
  id             String      @id @default(uuid())
  settingId      String
  setting        Setting     @relation(fields: [settingId], references: [id], onDelete: Cascade)
  version        Int
  type           SettingType
  value          String?
  encryptedValue Bytes?
  encryptionIv   Bytes?
  encryptionTag  Bytes?
  changedBy      String?
  changedAt      DateTime    @default(now())

  @@map("settings_history")
}

// Every privileged action (settings changes, user management, remote OCPP
// commands, firmware/certificate operations, backup/restore) is recorded
// here by the audit interceptor: who, when, what, old/new value.
model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("audit_log")
}

// One row per event CitrineOS's Subscription webhook (or a command's
// callbackUrl) pushes to us — see docs/architecture-proposal.md §8. This is
// the raw feed the Live-Message-Monitor and the OCPP testsuite (both a
// later increment) read from; it is populated starting now because
// receiving the webhook is only useful once something durable stores it.
enum CitrineOsMessageEvent {
  connected
  closed
  message

  @@map("citrineos_message_event")
}

enum CitrineOsMessageOrigin {
  ChargingStation
  ChargingStationManagementSystem

  @@map("citrineos_message_origin")
}

model CitrineOsMessageLog {
  id                 String                  @id @default(uuid())
  tenantId           String
  tenant             Tenant                  @relation(fields: [tenantId], references: [id])
  ocppConnectionName String
  event              CitrineOsMessageEvent
  origin             CitrineOsMessageOrigin?
  // Raw OCPP RPC frame as CitrineOS sent it (a JSON array, still encoded as
  // a string) — kept verbatim rather than re-parsed, so the monitor can
  // show exactly what was on the wire even if our own parsing has a bug.
  rawMessage         String?
  // CitrineOS's `info` map: correlationId, timestamp, protocol, action,
  // type — whatever it included for this event.
  info               Json?
  receivedAt         DateTime                @default(now())

  @@index([tenantId, ocppConnectionName, receivedAt])
  @@map("citrineos_message_log")
}

// OCPP-Controller-Testsuite (docs/architecture-proposal.md §8): runs a fixed
// sequence of steps against one station and records pass/fail/timeout per
// step with the raw request/response, so a compatibility report can be
// built per manufacturer/model/firmware/OCPP-version.
enum TestSuiteRunStatus {
  running
  completed
  aborted

  @@map("testsuite_run_status")
}

enum TestSuiteStepKind {
  // We send a TriggerMessage and wait for the station to (re)send the
  // requested message type as an independent, spontaneous Call.
  trigger
  // We send a CSMS-initiated command (RemoteStart, Reset, ...) and
  // correlate its response via a per-step callbackUrl.
  command
  // We send nothing; we wait for a message the station only sends on its
  // own initiative during real operation (Authorize, a real transaction) —
  // typically requires the operator to act on the station in parallel.
  observe

  @@map("testsuite_step_kind")
}

enum TestSuiteStepStatus {
  pending
  running
  pass
  fail
  timeout
  skipped

  @@map("testsuite_step_status")
}

model TestSuiteRun {
  id                 String             @id @default(uuid())
  tenantId           String
  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  ocppConnectionName String
  manufacturer       String?
  model              String?
  firmwareVersion    String?
  ocppVersion        String
  status             TestSuiteRunStatus @default(running)
  startedById        String?
  startedBy          User?              @relation(fields: [startedById], references: [id], onDelete: SetNull)
  startedAt          DateTime           @default(now())
  finishedAt         DateTime?

  steps TestSuiteStep[]

  @@index([tenantId, ocppConnectionName, startedAt])
  // Backs the compatibility matrix: latest run per station/manufacturer/
  // model/firmware/version combination.
  @@index([tenantId, manufacturer, model, firmwareVersion, ocppVersion])
  @@map("testsuite_run")
}

model TestSuiteStep {
  id             String              @id @default(uuid())
  runId          String
  run            TestSuiteRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  sequenceIndex  Int
  action         String
  kind           TestSuiteStepKind
  status         TestSuiteStepStatus @default(pending)
  requestPayload Json?
  responsePayload Json?
  // Plain-text explanation for Fail/Timeout/Skipped — e.g. "Station
  // rejected StartTransaction: FormatViolation — idTag missing", not a
  // raw stack trace.
  errorMessage   String?
  startedAt      DateTime?
  finishedAt     DateTime?
  durationMs     Int?

  @@unique([runId, sequenceIndex])
  @@map("testsuite_step")
}
