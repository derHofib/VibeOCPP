# Bootstrap values only. Everything else lives in the `settings` table and
# is managed at runtime through the SuperAdmin UI — see docs/architecture-proposal.md.

# Product database (NOT the CitrineOS database).
DATABASE_URL="postgresql://csms:csms_dev_pw@localhost:5432/csms_product?schema=public"

# JWT signing secrets for access/refresh tokens. Generate with:
#   openssl rand -base64 48
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"

# AES-256-GCM master key for encrypting secret-typed settings (Stripe keys,
# SMTP passwords, etc). Must decode to exactly 32 bytes. Generate with:
#   openssl rand -base64 32
SETTINGS_MASTER_KEY="change-me"

PORT="3000"
